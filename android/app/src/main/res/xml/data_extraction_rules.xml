<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup/transfer rules. `allowBackup="false"` already disables cloud backup; this covers
  the OTHER path — device-to-device transfer — which that flag does not.

  Everything is excluded, and the reason is the same as the manifest's: since 2026-08-12 the ingest
  bearer tokens live in SharedPreferences rather than being compiled into BuildConfig, so a
  transferred profile would carry a live credential onto a new device. The settings take under a
  minute to re-enter and the geofence coordinates are deliberately device-only.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
